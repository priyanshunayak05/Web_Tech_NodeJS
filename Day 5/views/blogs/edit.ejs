<body>
     <a href="/blogs">Back</a>
    <h1>Edit Blog</h1>
    <form action="/blogs/<%= blog.id %>?_method=PATCH" method="POST">
        <div>
            <label for="author">Author : </label>
            <input type="text" name ="author"  value="<%= foundBlog.author %>">
        </div>
        <div>
            <label for="comment">comment : </label>
            <input type="text" name ="comment"  value="<%= foundBlog.comment %>">   
        </div>
        <button type="submit">Edit Blog</button>
    </form>
    
</body> 
