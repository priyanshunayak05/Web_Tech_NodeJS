<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Display all the Netas</h1>
    <% for(let item of allNetas) { %>
        <h2>Name:<%= item.name %></h2>
        <h3>Party:<%= item.party %></h3>
        <h3>IsMale<%= item.isMale></h3>
        <h3>IsCorrupt:<%= item.isCorrupt %></h3>
        <% } %>

        <hr>
</body>
</html>